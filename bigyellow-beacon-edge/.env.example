# BigYellow Beacon - Edge Configuration
BEACON_PLANE=edge
HOST=0.0.0.0
PORT=8000
DEBUG=true
ROOT_PATH=

# Vessel Identification & Sync Secrets
VESSEL_ID=MV-PACIFIC-STAR
VESSEL_SECRET=marine-secret-mv-pacific-star-2026
VESSEL_API_KEY=vessel-api-key-mv-pacific-star
SHORE_URL=http://localhost:8001

# Edge Database (defaults to local SQLite if Postgres is unavailable)
EDGE_DATABASE_URL=postgresql://beacon:beacon123@localhost:5432/beacon_edge

# Crew Authentication
EDGE_JWT_SECRET_KEY=beacon-edge-jwt-signing-secret-mv-pacific-star-2026
EDGE_JWT_ALGORITHM=HS256
EDGE_JWT_EXPIRE_HOURS=12

# Local Ollama AI Gateway (models must be pulled on the VM: ollama pull <model>)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_STRUCTURE_MODEL=gemma3n:e4b
OLLAMA_CHAT_MODEL=gemma3n:e2b
OLLAMA_VISION_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_TIMEOUT_SECONDS=60

# faster-whisper voice transcription (cuda + float16 on GPU VM; cpu + int8 fallback)
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
