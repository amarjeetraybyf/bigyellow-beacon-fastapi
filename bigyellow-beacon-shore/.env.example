# BigYellow Beacon Shore Server Configuration
# PostgreSQL 16 with pgvector (Cloud SQL or RDS)
SHORE_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/beacon_shore"

# Server Port and Host
SHORE_PORT=8001
PORT=8001
HOST="0.0.0.0"
DEBUG=true

# Reverse proxy prefix if hosted behind an API Gateway (e.g. "/shore")
ROOT_PATH=""

# JWT Secret Key for Shore Staff (minimum 32 characters)
SHORE_JWT_SECRET_KEY="beacon-shore-jwt-secret-key-salt-min32!!"

# Shore AI backend: auto | ollama | vertex | gemini
# auto = try local Ollama first, then Vertex/Gemini if configured, else deterministic fallback
SHORE_AI_BACKEND=auto

# Local Ollama (models must be pulled on the VM: ollama pull <model>)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_STRUCTURE_MODEL=gemma3n:e4b
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_TIMEOUT_SECONDS=60

# Vertex AI Gemini (optional cloud fallback: needs project + ADC/service account)
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="us-central1"

# Google AI Studio API key (optional cloud fallback)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Imagen cover art for /learnings/draft (Vertex AI project required)
IMAGEN_ENABLED=true
IMAGEN_MODEL=imagen-3.0-generate-002
# Soft wait inside draft; if exceeded, image_status=pending and FE polls GET /learnings/{id}
IMAGEN_DRAFT_WAIT_SECONDS=8
# SHORE_MEDIA_DIR=./media
