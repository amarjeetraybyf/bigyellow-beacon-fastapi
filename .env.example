# BigYellow Beacon FastAPI Environment Configuration

# Server settings
PORT=8000
HOST="0.0.0.0"
DEBUG=true

# Gemini AI API Key for onshore intelligence & copilot synthesis
GEMINI_API_KEY=""

# Application Host URL
APP_URL="http://localhost:8000"

# Firebase Cloud Server Configuration
# Path to service account JSON key file (e.g. ./firebase-key.json)
FIREBASE_SERVICE_ACCOUNT_KEY=""
FIREBASE_PROJECT_ID=""
FIREBASE_DATABASE_URL=""
# Set to true to force offline fallback or if working completely disconnected
FIREBASE_OFFLINE_FALLBACK=true
